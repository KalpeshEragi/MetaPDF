# Copy to env/.env and fill in. Never commit the real file.
GOOGLE_API_KEY=your-gemini-api-key
FLASK_SECRET_KEY=any-long-random-string

# Optional overrides (defaults shown) — see App/rag/config.py
# RAG_LLM_MODEL=gemini-3.5-flash-lite
# RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# RAG_RETRIEVAL_MODE=hybrid        # dense | bm25 | hybrid
# RAG_USE_RERANKER=1
# RAG_CHUNK_TOKENS=320
# RAG_FINAL_K=5
# RAG_DEVICE=auto                  # auto | cuda | cpu
# MAX_UPLOAD_MB=50
# FLASK_DEBUG=0
